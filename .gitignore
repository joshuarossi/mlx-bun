# trained adapters/checkpoints (weights, not source) + training run logs
adapters/
train.log
*.train.log
train-*.log
*-capability.log
__pycache__/

# DiffusionGemma large/regenerable golden dumps — the full [1,256,262144] f32
# logit tensors (256MB each) exceed GitHub's limit, and the per-stage diagnostic
# intermediates are regenerable via scripts/gen-diffusion-*.py. The small .json
# goldens + tiny input bins ARE committed.
goldens/diffusion/forward-logits.bin
goldens/diffusion/presoftcap-logits.bin
goldens/diffusion/enc-*.bin
goldens/diffusion/dec-*.bin
goldens/diffusion/l0-*.bin
goldens/diffusion/vision-*.bin

# Golden .bin fixtures are MACHINE-SPECIFIC regenerable artifacts (scripts/regen-*
# + the oracle venv) — never tracked (they bloated history to 179 MB; the JSON
# manifests/trajectories stay tracked). See goldens/README.md.
goldens/**/*.bin
goldens/**/*.npz
# turboquant.json is a full golden-vector payload (1.3 MB of float arrays), not
# a small manifest — regenerable via scripts/regen-turboquant-goldens.ts + the
# vendored reference (lab/repro/vllm-metal-turboquant/), so .bin policy applies.
goldens/turboquant.json

# Adapter test fixtures: bytes live outside git (repo-cleanup-plan.md B2 —
# scripts/fetch-test-fixtures.sh; shas pinned there). Training data/config
# for them stay tracked in fixtures/adapters/.
fixtures/adapters/*/adapters.safetensors
bench-faithful-matrix-*
# Per-model learned expert routing profile (runtime-derived, atomically replaced).
.coli_usage
.coli_usage.tmp-*

# Dated benchmark/report artifacts never belong at root (curated numbers
# go to benchmarks/RESULTS.md; raw dumps to reports/, which is untracked)
/benchmarks-*.md
/benchmarks-*.json
/bench-*.md
/bench-*.json
/tmp/
/*.log
.claude/launch.json
