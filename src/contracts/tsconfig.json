{
  "compilerOptions": {
    "lib": ["ES2022"],
    "target": "ES2022",
    "module": "Preserve",
    "moduleResolution": "bundler",
    "types": [],
    "strict": true,
    "skipLibCheck": false,
    "noUncheckedIndexedAccess": true,
    "noEmit": true
  },
  "include": ["./*.ts", "../engine/**/*.ts", "../inference/**/*.ts"]
}
