def rawHead (table : List (List Nat)) (layer : Fin 16) (i : Fin 256) : BF :=
  dictionary[((table[layer.val]?.getD [])[i.val]?.getD 0)]?.getD CheckpointRanges.zeroCap

def query (layer : Fin 16) : Fin 256 → BF := CheckpointTransforms.shiftNorm (rawHead queryIndices layer)
def key (layer : Fin 16) : Fin 256 → BF := CheckpointTransforms.shiftNorm (rawHead keyIndices layer)
def mainNorm (_layer : Fin 129) : Fin 5120 → BF :=
  CheckpointTransforms.shiftNorm (fun _ => CheckpointRanges.zeroCap)

set_option maxRecDepth 30000 in
set_option maxHeartbeats 0 in
theorem dictionary_checked : TensorWords.check dictionary CheckpointRanges.threeCap = true := by
  decide +kernel

set_option maxRecDepth 30000 in
set_option maxHeartbeats 0 in
theorem dimensions_checked : dictionary.length = 681 ∧ queryIndices.length = 16 ∧ keyIndices.length = 16 ∧
    queryIndices.all (fun row => decide (row.length = 256) && row.all (fun index => decide (index < 681))) = true ∧
    keyIndices.all (fun row => decide (row.length = 256) && row.all (fun index => decide (index < 681))) = true := by
  decide +kernel

theorem rawHead_bound (table : List (List Nat)) (layer : Fin 16) (i : Fin 256) :
    Model.isFinite (rawHead table layer i) = true ∧ |Model.toReal (rawHead table layer i)| ≤ 3 := by
  have fallback : Model.isFinite CheckpointRanges.zeroCap = true ∧
      |Model.toReal CheckpointRanges.zeroCap| ≤ Model.toReal CheckpointRanges.threeCap := by
    refine ⟨by decide +kernel, ?_⟩
    rw [CheckpointRanges.zeroCap_real, CheckpointRanges.threeCap_real]
    norm_num
  simpa only [rawHead, CheckpointRanges.threeCap_real] using
    TensorWords.check_getD dictionary CheckpointRanges.threeCap CheckpointRanges.zeroCap dictionary_checked fallback
      ((table[layer.val]?.getD [])[i.val]?.getD 0)

theorem query_bound (layer : Fin 16) (i : Fin 256) :
    Model.isFinite (query layer i) = true ∧ |Model.toReal (query layer i)| ≤ 4 :=
  CheckpointTransforms.head_norm_bound _ (rawHead_bound queryIndices layer) i

theorem key_bound (layer : Fin 16) (i : Fin 256) :
    Model.isFinite (key layer i) = true ∧ |Model.toReal (key layer i)| ≤ 4 :=
  CheckpointTransforms.head_norm_bound _ (rawHead_bound keyIndices layer) i

theorem mainNorm_exact (layer : Fin 129) (i : Fin 5120) :
    Model.isFinite (mainNorm layer i) = true ∧ Model.toReal (mainNorm layer i) = 1 :=
  CheckpointTransforms.zero_norm _ (fun _ => by decide +kernel) (fun _ => CheckpointRanges.zeroCap_real) i

theorem mainNorm_bound (layer : Fin 129) (i : Fin 5120) :
    Model.isFinite (mainNorm layer i) = true ∧ |Model.toReal (mainNorm layer i)| ≤ 1 := by
  have h := mainNorm_exact layer i
  exact ⟨h.1, by rw [h.2]; norm_num⟩

