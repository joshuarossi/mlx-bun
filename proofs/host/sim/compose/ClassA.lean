set_option maxHeartbeats 1000000
namespace Host.Ts.Sim.Compose
open Host.Ts Host.Ts.Sim Host.Ts.Sim.Prefill Host.Ts.Sim.Lin Host.Ts.Sim.Lin.Cls

/-! # The prefill classes' steps from their pieces (generated by `host/sim/compose/gen.ts`)

`<class>.steps P`: the class's step at every length where it applies, from its cover (the row of
each step) and, in each row, the row's chain of pieces (`setup_shape`, `step_shape`,
`final_shape`) with the oracles discharged by the row's checks. -/

section
variable {F : Ffi} {I : PrefInvsW F}

/-- setup class `setup_early`: the step from its rows' pieces. -/
def setup_early.total (P : Pieces F I) : Nat := (⟨P.q1.g0a.n, P.q1.chunk_K8__g0a__g0b.n, P.q1.g0b.n⟩ : SetupLens).total

theorem setup_early.steps (P : Pieces F I) : SetupS I (.early) (setup_early.total P) :=
  setupS_of_rows Host.Ts.Sim.Lin.Cls.setup_early.cover fun r hr L h1 h2 ha hin => by
    simp only [setup_early.rows, List.mem_cons, List.not_mem_nil, or_false] at hr
    rcases hr with rfl
    · exact setup_shape (P.q1.g0a.ok _ (mem_at (k := 0) rfl) _ hin ⟨obl_of_row hin (P.q1.g0a.chk _ (mem_at (k := 0) rfl)), trivial⟩)
        (P.q1.chunk_K8__g0a__g0b.ok _ (mem_at (k := 0) rfl) _ hin ⟨obl_of_row hin setup_early.r0.chunk, trivial⟩)
        (P.q1.g0b.ok _ (mem_at (k := 0) rfl) _ hin ⟨obl_of_row hin (P.q1.g0b.chk _ (mem_at (k := 0) rfl)), trivial⟩)

