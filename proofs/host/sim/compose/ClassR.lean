/-- **The steps of the prompts with no Neural Engine forward.** The quantifiers are `ClassSteps`'s. -/
structure ClassStepsR where
  nSetup : SetupClass → Nat
  setup : ∀ c ∈ ([.early, .h0] : List SetupClass), SetupS I c (nSetup c)
  nFirstTail : Nat → Nat
  firstTail : ∀ X ∈ List.range 22, FirstTailS I X (nFirstTail X)
  nCold : Nat
  finalCold : FinalS I .first .cold nCold
  nOrd : Nat
  finalOrd : FinalS I .tailed (.warm .ord) nOrd

/-- **The classes' steps from the pieces.** -/
def classStepsR (P : PiecesR F I) : ClassStepsR I where
  nSetup := countOf [((.early : SetupClass), setup_early.total P), ((.h0 : SetupClass), setup_h0.total P)]
  setup := all_cons' (setup_early.steps P) (
      all_cons' (setup_h0.steps P) (all_nil'))
  nFirstTail := countOf [(0, first_tail_x0.total P), (1, first_tail_x1.total P), (2, first_tail_x2.total P), (3, first_tail_x3.total P), (4, first_tail_x4.total P), (5, first_tail_x5.total P), (6, first_tail_x6.total P), (7, first_tail_x7.total P), (8, first_tail_x8.total P), (9, first_tail_x9.total P), (10, first_tail_x10.total P), (11, first_tail_x11.total P), (12, first_tail_x12.total P), (13, first_tail_x13.total P), (14, first_tail_x14.total P), (15, first_tail_x15.total P), (16, first_tail_x16.total P), (17, first_tail_x17.total P), (18, first_tail_x18.total P), (19, first_tail_x19.total P), (20, first_tail_x20.total P), (21, first_tail_x21.total P)]
  firstTail := by
    rw [range22]
    exact all_cons' (first_tail_x0.steps P) (
      all_cons' (first_tail_x1.steps P) (
      all_cons' (first_tail_x2.steps P) (
      all_cons' (first_tail_x3.steps P) (
      all_cons' (first_tail_x4.steps P) (
      all_cons' (first_tail_x5.steps P) (
      all_cons' (first_tail_x6.steps P) (
