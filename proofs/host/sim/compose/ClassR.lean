      all_cons' (first_tail_x8.steps P) (
      all_cons' (first_tail_x9.steps P) (
      all_cons' (first_tail_x10.steps P) (
      all_cons' (first_tail_x11.steps P) (
      all_cons' (first_tail_x12.steps P) (
      all_cons' (first_tail_x13.steps P) (
      all_cons' (first_tail_x14.steps P) (
      all_cons' (first_tail_x15.steps P) (
      all_cons' (first_tail_x16.steps P) (
      all_cons' (first_tail_x17.steps P) (
      all_cons' (first_tail_x18.steps P) (
      all_cons' (first_tail_x19.steps P) (
      all_cons' (first_tail_x20.steps P) (
      all_cons' (first_tail_x21.steps P) (all_nil'))))))))))))))))))))))
