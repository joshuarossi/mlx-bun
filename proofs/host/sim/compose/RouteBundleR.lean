/-- The length equalities between the rows of a class. -/
structure RoutePiecesREqs (F : Ffi) (I : PrefInvsW F) (T : Nat) (tk : Nat → Nat) (K : RoutePiecesRCuts F) (q1 : RoutePiecesR_q1 F I T tk K) where
  trivial : True

/-- **The pieces.** -/
structure RoutePiecesR (F : Ffi) (I : PrefInvsW F) (T : Nat) (tk : Nat → Nat) where
  cuts : RoutePiecesRCuts F
  q1 : RoutePiecesR_q1 F I T tk cuts
  eqs : RoutePiecesREqs F I T tk cuts q1

