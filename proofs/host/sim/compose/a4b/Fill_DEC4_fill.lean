    (DEC4_fill.g3 b0 NB DEC4_fill.eN).eA ++ Host.Load.Run.Tpl.DEC4_fill.eR = [.num (.ref Host.Load.Run.Prompt.addrPrompt.tok)] := rfl

/-- The route's wide frames are the acceptance's. -/
theorem DEC4_fill.hW : Disp.Wp (Dec4.J DEC4_fill.Pw DEC4_fill.fr DEC4_fill.wd) Host.Load.Run.Tpl.wideG := fun _ _ h => h

/-- The decode loop's frames at the route's: the chain's acceptance's. -/
theorem DEC4_fill.hfr (q : List Val) : ∀ a, a ∈ Host.Load.Run.Prompt.addrPrompt.fwd :: Host.Load.Run.Prompt.addrPrompt.emit :: (framesG Host.Load.Run.Tpl.DEC4_fill.s0 q).xs ↔ a ∈ DEC4_fill.fr := fun _ => Iff.rfl

