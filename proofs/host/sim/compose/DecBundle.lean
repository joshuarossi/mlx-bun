  cuts := [fun i x0 => D.c1 (decI L T i (tk (i + 1))) x0,
    fun i x0 => D.c2 (decI L T i (tk (i + 1))) x0,
    fun i x0 => D.c3 (decI L T i (tk (i + 1))) x0,
