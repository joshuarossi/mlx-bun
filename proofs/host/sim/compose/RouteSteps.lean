/-- POST's count by class. -/
def postN (H : RoutePieces F I T tk) : PostClass → Nat := countOf [(PostClass.r0, route_post_r0.total H), (PostClass.r255, route_post_r255.total H), (PostClass.r254, route_post_r254.total H), (PostClass.other, route_post_other.total H)]

/-- **POST at every length of the range.** -/
theorem postStep (H : RoutePieces F I T tk) {L : Nat} (h1 : 1 ≤ L) (h2 : L ≤ 262143) (hq : RouteKind.post.Holds L T (tk 1) (tk 2)) :
    CutStep (I.ps L) (I.dec L) (postN H (postOf L)) := by
  have hall : ∀ c ∈ postClasses, RouteS I T tk .post (fun i => I.dec i.L) c (postN H c) := by
    unfold postClasses
    exact all_cons' (route_post_r0.steps H) (
      all_cons' (route_post_r255.steps H) (
      all_cons' (route_post_r254.steps H) (
      all_cons' (route_post_other.steps H) (all_nil'))))
  have hc := post_cover (L := L)
  exact hall _ hc.1 L h1 h2 hq hc.2.1

