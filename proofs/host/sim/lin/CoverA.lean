import host.sim.lin.Table
set_option maxRecDepth 100000
namespace Host.Ts.Sim.Lin.Cls
open Host.Ts Host.Ts.Sim Host.Ts.Sim.Lin Host.Ts.Sim.Prefill

/-! # Cover proofs of the class table (generated by `host/sim/lin/gen.ts table`)

`<class>.cover`: every step of the class is in one of its rows. The facts of the class
(`*.Applies`, the chunk's band) are put in context, the decision tree's tests split the
rows, and each row's tags, box and forms close by `omega` at the witnesses `vx [...]`. -/

theorem setup_early.cover : SetupP (.early) setup_early.rows := by
  intro L h1 h2 ha
  simp only [SetupClass.Applies] at ha
  have hC : chunkC L = 2048 := by rw [chunkC_eq L (by omega)]; (repeat' split) <;> omega
  exact ⟨setup_early.r0, .head _, by row_close [setup_early.r0, setupI, hC], vx [(L : Int)],
    by row_close [setup_early.r0], by row_close [setup_early.r0, setupI, hC]⟩

