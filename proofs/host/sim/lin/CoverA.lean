theorem first_drain_2048.cover : FirstP (.drain 2048) first_drain_2048.rows := by
  intro L h1 h2 ha
  obtain ⟨hC0, hd⟩ := ha
  have hC : chunkC L = 2048 := hC0.symm
  have hb := (chunkC_bounds (L := L) (by omega)).1 hC
  simp only [drains, hC] at hd
  have hn : firstN L = 2048 := by simp only [firstN, drains, hC]; (repeat' split) <;> omega
  by_cases s0 : (L : Int) ≤ 2049
  · exact ⟨first_drain_2048.r1, .tail _ (.head _), by row_close [first_drain_2048.r1, firstI, hn, hC], vx [],
      by row_close [first_drain_2048.r1], by row_close [first_drain_2048.r1, firstI, hn, hC]⟩
  · exact ⟨first_drain_2048.r0, .head _, by row_close [first_drain_2048.r0, firstI, hn, hC], vx [(L : Int)],
      by row_close [first_drain_2048.r0], by row_close [first_drain_2048.r0, firstI, hn, hC]⟩

