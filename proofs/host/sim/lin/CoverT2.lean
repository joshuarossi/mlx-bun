import host.sim.lin.Table
set_option maxRecDepth 100000
namespace Host.Ts.Sim.Lin.Cls
open Host.Ts Host.Ts.Sim Host.Ts.Sim.Lin Host.Ts.Sim.Prefill

/-! # Cover proofs of the class table (generated by `host/sim/lin/gen.ts table`)

`<class>.cover`: every step of the class is in one of its rows. The facts of the class
(`*.Applies`, the chunk's band) are put in context, the decision tree's tests split the
rows, and each row's tags, box and forms close by `omega` at the witnesses `vx [...]`. -/

theorem tail_512_x0_g.cover : TailP (⟨512, 0, true⟩) tail_512_x0_g.rows := by
  intro L h1 h2 ha
  obtain ⟨hC0, hd, ht, hX, hg⟩ := ha
  simp only at hC0 hX hg
  have hC : chunkC L = 512 := hC0.symm
  have hb := (chunkC_bounds (L := L) (by omega)).2.2.1 hC
  have hX' := (rowMem_iff (X := 0) (lo := 1) (hi := 1) (by decide)).1 hX
  have hg' := of_decide_eq_true hg.symm
  simp only [drains, tailRows, hC] at hd ht hX' hg'
  exact ⟨tail_512_x0_g.r0, .head _, by row_close [tail_512_x0_g.r0, tailI, drains, tailRows, hC], vx [((L : Int) - 1) / 512],
    by row_close [tail_512_x0_g.r0], by row_close [tail_512_x0_g.r0, tailI, drains, tailRows, hC]⟩

