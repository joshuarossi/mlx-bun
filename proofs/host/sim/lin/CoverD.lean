import host.sim.lin.Table
set_option maxRecDepth 100000
namespace Host.Ts.Sim.Lin.Cls
open Host.Ts Host.Ts.Sim Host.Ts.Sim.Lin Host.Ts.Sim.Prefill

/-! # The decode classes' covers (generated by `host/sim/lin/gen.ts table`)

`<decode class>.cover`: every iteration of a decode case (`decI L T i t1` where `DecKind.Sel` holds) is in
its row. `dec_cover`: the decode table's keys are the cases, and every iteration is in a row of its case. -/

theorem dec_ord.cover : DecP .ord dec_ord.rows := by
  intro L T i t1 h1 hc hs ht hne
  simp only [DecKind.Sel, DecKind.Holds] at hs
  exact ⟨dec_ord.r0, .head _, by row_close [dec_ord.r0, decI], vx [(i : Int) / 256, (i : Int) % 256, ((L + i + 1 : Nat) : Int) / 256, ((L + i + 1 : Nat) : Int) % 256, (T : Int) - i - 3, (t1 : Int)],
    by row_close [dec_ord.r0], by row_close [dec_ord.r0, decI]⟩

