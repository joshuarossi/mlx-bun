import host.sim.lin.Table
import host.sim.stage.ChunkRun
set_option maxRecDepth 100000
namespace Host.Ts.Sim.Lin.Cls
open Host.Ts Host.Ts.Sim Host.Ts.Sim.Lin Host.Ts.Sim.Prefill

/-! # The stage templates' oracles over the prefill classes (generated by `host/sim/lin/gen.ts checks host/sim/lin/stages.json`)

One check per (piece, row): the oracle of the stage class the row's tag names, over the row's box
(`good_of_row`: correct at every step of the row). Pieces: `chunk` (`chunkSize`, `host.sim.stage.ChunkRun`,
variable 0 = `L`), `nps` (`nextPrefillStep`, `host.sim.stage.NextStepRun`, variables `L`, `o`, `C`),
`kv` and `kv2` (the KV append, `host.sim.stage.CacheRun`, variables `o`, `cap`, `n`; `kv2`, POST's
second decode row, at `e`, `cap1`). -/

theorem setup_early.r0.chunk : goodLin setup_early.r0.ps (varsOf setup_early.r0.V [(0, .L)]) (Stage.ChunkSize.K8.O) = true := by decide +kernel
theorem setup_h0.r0.chunk : goodLin setup_h0.r0.ps (varsOf setup_h0.r0.V [(0, .L)]) (Stage.ChunkSize.K2048.O) = true := by decide +kernel
theorem setup_h1.r0.chunk : goodLin setup_h1.r0.ps (varsOf setup_h1.r0.V [(0, .L)]) (Stage.ChunkSize.K1024.O) = true := by decide +kernel
theorem setup_h2.r0.chunk : goodLin setup_h2.r0.ps (varsOf setup_h2.r0.V [(0, .L)]) (Stage.ChunkSize.K512.O) = true := by decide +kernel
theorem setup_h3.r0.chunk : goodLin setup_h3.r0.ps (varsOf setup_h3.r0.V [(0, .L)]) (Stage.ChunkSize.K256.O) = true := by decide +kernel
theorem setup_h4.r0.chunk : goodLin setup_h4.r0.ps (varsOf setup_h4.r0.V [(0, .L)]) (Stage.ChunkSize.K128.O) = true := by decide +kernel
theorem setup_h5.r0.chunk : goodLin setup_h5.r0.ps (varsOf setup_h5.r0.V [(0, .L)]) (Stage.ChunkSize.K64.O) = true := by decide +kernel

end Host.Ts.Sim.Lin.Cls
