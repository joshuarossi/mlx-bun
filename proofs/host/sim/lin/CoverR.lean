/-! # The route classes' covers (generated by `host/sim/lin/gen.ts table`)

`<route class>.cover`: every step of a route position at a post class (`routeI L T t1 t2` with the
position's facts `RouteKind.Holds`) is in one of its rows. `route_cover`: the route table's keys are
the route classes, and every route step is in a row of its class. -/

theorem route_post_r0.cover : RouteP .post .r0 route_post_r0.rows := by
  intro L T t1 t2 h1 h2 hq ha
  simp only [RouteKind.Holds] at hq
  have hk := postOf_r0 ha
  have hr := chunkC_range (L := L) (by omega)
  by_cases et2 : t2 = 248044
  · exact ⟨route_post_r0.r0, .head _, by row_close [route_post_r0.r0, routeI], vx [(L : Int) / 256, (chunkC L : Int), (T : Int), (t1 : Int)],
      by row_close [route_post_r0.r0], by row_close [route_post_r0.r0, routeI]⟩
  · exact ⟨route_post_r0.r1, .tail _ (.head _), by row_close [route_post_r0.r1, routeI], vx [(L : Int) / 256, (chunkC L : Int), (T : Int), (t1 : Int), (t2 : Int)],
      by row_close [route_post_r0.r1], by row_close [route_post_r0.r1, routeI]⟩

