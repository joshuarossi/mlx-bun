/-- A route class's rows cover it. -/
def RQ (q : RouteKind × PostClass) (rs : List Row) : Prop := RouteP q.1 q.2 rs

theorem routeTable_all : ∀ q ∈ routeTable, RQ q.1 q.2 := by
  unfold routeTable
  exact all_cons (P := RQ) route_post_r0.cover (
    all_cons (P := RQ) route_post_r255.cover (
    all_cons (P := RQ) route_post_r254.cover (
    all_cons (P := RQ) route_post_other.cover (
    all_cons (P := RQ) route_pathA_r0.cover (
    all_cons (P := RQ) route_pathA_r255.cover (
    all_cons (P := RQ) route_pathA_r254.cover (
    all_cons (P := RQ) route_pathA_other.cover (
    all_cons (P := RQ) route_pathB_r0.cover (
    all_cons (P := RQ) route_pathB_r255.cover (
    all_cons (P := RQ) route_pathB_r254.cover (
    all_cons (P := RQ) route_pathB_other.cover (
    all_cons (P := RQ) route_pathC_r0.cover (
    all_cons (P := RQ) route_pathC_r255.cover (
    all_cons (P := RQ) route_pathC_r254.cover (
    all_cons (P := RQ) route_pathC_other.cover (all_nil))))))))))))))))

/-- **The route table covers the route's positions.** -/
theorem route_cover : routeTable.map Prod.fst = routeKeys ∧
    ∀ k L T t1 t2, 1 ≤ L → L ≤ 262143 → k.Holds L T t1 t2 →
      ∃ r ∈ rowsOf routeTable (k, postOf L), InRow r (routeI L T t1 t2) := by
  refine ⟨routeTable_keys, fun k L T t1 t2 h1 h2 hk => ?_⟩
  have hp := (post_cover (L := L)).1
  have hmem : (k, postOf L) ∈ routeTable.map Prod.fst := by
    rw [routeTable_keys]
    simp only [routeKeys, List.mem_flatMap, List.mem_map]
    exact ⟨k, by cases k <;> simp, postOf L, hp, rfl⟩
  exact rowsOf_all (P := RQ) routeTable_all (k, postOf L) hmem L T t1 t2 h1 h2 hk
    (post_cover (L := L)).2.1

