import host.ts.Module
import host.mlx.Ffi
namespace Host.Ts.Tests.Decode
open Host.Ts

/-! # Checkpoint data as host values

The decode drivers read the checkpoint's tensor table and `quantization`
config as JavaScript values. A file this large is data, not code: a host
module builds the values from Lean literals (`Checkpoint`, generated by
`checkpoint-header.ts --lean-module`) instead of the lexer and parser taking a
260 KB literal. The values are what the drivers' literals would denote: the
`SHARDS` rows `[file, [[name, dtype, shape, begin, end], …]]` and the
`QUANTIZATION` object. -/

/-- A JSON value. -/
inductive Js where
  | null
  | bool (b : Bool)
  | num (i : Int)
  | str (s : List Char)
  | arr (xs : List Js)
  | obj (kvs : List (List Char × Js))

section
variable {S : Type}

mutual
/-- The JavaScript value of a JSON value: fresh arrays and plain objects. -/
def jsVal : Js → B S Val
  | .null => pure .null
  | .bool b => pure (.bool b)
  | .num i => pure (intV i)
  | .str s => pure (.str s)
  | .arr xs => do
    let vs ← jsVals xs
    modifyGet fun s => let (a, s) := newArray s vs; (.obj a, s)
  | .obj kvs => do
    let o ← newObj (.obj aObjectProto)
    jsProps o kvs
    pure (.obj o)
def jsVals : List Js → B S (List Val)
  | [] => pure []
  | x :: xs => do let v ← jsVal x; let vs ← jsVals xs; pure (v :: vs)
def jsProps (o : Nat) : List (List Char × Js) → B S Unit
  | [] => pure ()
  | (k, v) :: kvs => do let x ← jsVal v; setP o (.str k) (.data x true true); jsProps o kvs
end

end

/-- A tensor row: name, safetensors dtype, shape, data begin and end. -/
abbrev Row := List Char × List Char × List Nat × Nat × Nat

/-- `mlx_dtype` code of a safetensors dtype name (`checkpoint-header.ts`). -/
def dtypeCode (d : List Char) : Nat :=
  match String.ofList d with
  | "BOOL" => 0 | "U8" => 1 | "U16" => 2 | "U32" => 3 | "U64" => 4 | "I8" => 5 | "I16" => 6 | "I32" => 7
  | "I64" => 8 | "F16" => 9 | "F32" => 10 | "F64" => 11 | "BF16" => 12 | _ => 13

/-- The driver's `SHARDS` value of shard rows under directory `dir`. -/
def shardsJs (shards : List (List Char × List Row)) : Js :=
  .arr (shards.map fun (f, rows) => .arr [.str f, .arr (rows.map fun (n, d, sh, b, e) =>
    .arr [.str n, .str d, .arr (sh.map fun i => .num (Int.ofNat i)), .num (Int.ofNat b), .num (Int.ofNat e)])])

/-- The MLX FFI model's header table of the same rows (path `dir/file`). -/
def headerOf (dir : List Char) (shards : List (List Char × List Row)) : List (List Char × Host.Mlx.Ffi.Header) :=
  shards.map fun (f, rows) => (dir ++ '/' :: f, rows.map fun (n, d, sh, _, _) => (n, sh, dtypeCode d))

/-- The host module `checkpoint`: `SHARDS` and `QUANTIZATION`. -/
def ckptMod {S : Type} (shards : List (List Char × List Row)) (quant : Js) : HMod S :=
  ⟨chars!"checkpoint", do
    let sh ← jsVal (shardsJs shards)
    let q ← jsVal quant
    pure [(chars!"SHARDS", sh), (chars!"QUANTIZATION", q)]⟩

end Host.Ts.Tests.Decode
