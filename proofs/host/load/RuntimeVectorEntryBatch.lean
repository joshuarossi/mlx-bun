    (live framed : Nat → Prop) (before after : List Val) (old old' : List Event) (s : St P.F.S)
    (inst : Inst ν₀ (numberServer P.RestStream.micro0.micro2.S24) C₀)
    (h : Parametric.StateR (NumberRoles ν₀ ν C₀ C) FR R live framed before after old old' P.RestStream.micro0.micro2.s24 s)
    (inventory : RetainedInventory (entryNotes notes caller) ν₀ ν C₀ C R live P.RestStream.micro0.micro2.s24 s)
    (budget : s.next+16 ≤ 2^64)
    (namespaceEntry : notes.runtime.cells.cells Step230.address = some (.obj 4817))
    (pointerEntry : notes.runtime.cells.cells Step234.address = some (.obj 2638))
    (globalLive : live aGlobal) (globalFixed : R.a aGlobal = aGlobal) => by
  have countClosed (valuation : Nat → F64) : (SymE.lit (F64.ofNat 2)).eval valuation = Step247.sourceValue := rfl
  host_retained_chain P.F, [Step224.retained_transport,Step225.retained_transport,Step226.retained_transport,Step227.retained_transport,Step228.retained_transport,Step229.retained_transport,Step230.retained_transport,Step231.retained_transport,Step232.retained_transport,Step233.retained_transport,Step234.retained_transport,Step235.retained_transport,Step236.retained_transport,Step237.retained_transport,Step238.retained_transport,Step239.retained_transport,Step240.retained_transport,Step241.retained_transport,Step242.retained_transport,Step243.retained_transport,Step244.retained_transport,Step245.retained_transport,Step246.retained_transport,Step247.retained_transport,Step248.retained_transport] using h, inventory, inst
