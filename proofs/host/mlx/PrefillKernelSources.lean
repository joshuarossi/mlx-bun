/-- The name each constructor passes to `mlx_fast_metal_kernel_new`. -/
def name : PrefillKernel → List Char
  | .affine3Rows => chars!"mlx_bun_affine3_rows"
  | .affine4Rows => chars!"mlx_bun_affine4_rows"
  | .affineSplitMma => chars!"mlx_bun_affine_split_mma"
  | .gateUpCodebookMma => chars!"mlx_bun_trellis_gateup_codebook_mma"
  | .gateUpMmaWide => chars!"mlx_bun_trellis_gateup_mma_wide"
  | .downMmaWide => chars!"mlx_bun_trellis_down_mma_wide"
  | .downK3iMmaWide => chars!"mlx_bun_trellis_down_k3i_mma_wide"
  | .aneTrellisFill => chars!"mlx_bun_ane_trellis_fill"
  | .aneTrellisFillK3i => chars!"mlx_bun_ane_trellis_fill_k3i"
  | .aneWriteHalf => chars!"mlx_bun_ane_write_half"
  | .vectorExpand => chars!"mlx_bun_trellis_vector_expand"

