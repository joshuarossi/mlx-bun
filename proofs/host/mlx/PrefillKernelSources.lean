/-! The input and output names and the flags each constructor passes to `mlx_fast_metal_kernel_new`. -/

def inputNames : PrefillKernel → List (List Char)
  | .affine3Rows => [chars!"x", chars!"w", chars!"scales", chars!"biases"]
  | .affine4Rows => [chars!"x", chars!"w", chars!"scales", chars!"biases"]
  | .affineSplitMma => [chars!"x", chars!"w", chars!"scales", chars!"biases"]
  | .gateUpCodebookMma => [chars!"x", chars!"gcodes", chars!"gscales", chars!"ucodes", chars!"uscales"]
  | .gateUpMmaWide => [chars!"x", chars!"gcodes", chars!"gscales", chars!"ucodes", chars!"uscales"]
  | .downMmaWide => [chars!"x", chars!"codes", chars!"scales"]
  | .downK3iMmaWide => [chars!"x", chars!"codes", chars!"scales"]
  | .aneTrellisFill => [chars!"codes", chars!"scales", chars!"dst"]
  | .aneTrellisFillK3i => [chars!"codes", chars!"scales", chars!"dst"]
  | .aneWriteHalf => [chars!"src", chars!"dst"]
  | .vectorExpand => [chars!"codes", chars!"scales"]

def outputNames : PrefillKernel → List (List Char)
  | .affine3Rows => [chars!"y"]
  | .affine4Rows => [chars!"y"]
  | .affineSplitMma => [chars!"y"]
  | .gateUpCodebookMma => [chars!"mid"]
  | .gateUpMmaWide => [chars!"mid"]
  | .downMmaWide => [chars!"partial"]
  | .downK3iMmaWide => [chars!"partial"]
  | .aneTrellisFill => [chars!"done"]
  | .aneTrellisFillK3i => [chars!"done"]
  | .aneWriteHalf => [chars!"done"]
  | .vectorExpand => [chars!"out"]

/-- `ensureRowContiguous` (absent: `true`). -/
def rowContiguous : PrefillKernel → Bool
  | .affine3Rows => true
  | .affine4Rows => true
  | .affineSplitMma => true
  | .gateUpCodebookMma => true
  | .gateUpMmaWide => true
  | .downMmaWide => true
  | .downK3iMmaWide => true
  | .aneTrellisFill => true
  | .aneTrellisFillK3i => true
  | .aneWriteHalf => true
  | .vectorExpand => true

/-- `atomicOutputs` (absent: `false`). -/
def atomicOutputs : PrefillKernel → Bool
  | .affine3Rows => false
  | .affine4Rows => false
  | .affineSplitMma => false
  | .gateUpCodebookMma => false
  | .gateUpMmaWide => false
  | .downMmaWide => false
  | .downK3iMmaWide => false
  | .aneTrellisFill => false
  | .aneTrellisFillK3i => false
  | .aneWriteHalf => false
  | .vectorExpand => false

