import host.mlx.FfiEval
namespace Host.Mlx.SourceKernels
open Host.Mlx.FfiEval
set_option maxRecDepth 100000
set_option maxHeartbeats 0

/-! Exact UTF-8 source/header bytes passed to the ten route kernel constructors.
KernelSourceBinding.ts checks these literals against the pinned TypeScript.
The existing parsed-source bindings check each body's numerical programs. -/

def sources : KernelSources where
  source
    | .affineRow => chars!"\n  constexpr int BPL = 2 * BITS;                   // weight bytes per lane per K step\n  constexpr int ROWB = K * BITS / 8;\n  constexpr int GROUPS = K / 64;\n  const uint sg = simdgroup_index_in_threadgroup, lane = thread_index_in_simdgroup;\n  // MLX's x_thread for every 16-value chunk of x, and each chunk's sum.\n  threadgroup float xs[K];\n  threadgroup float ss[K / 16];\n  for (int c = (int)(sg * 32 + lane); c < K / 16; c += S * 32) {\n    thread float t[16];\n    ss[c] = mlxq_load_vector<T, BITS>(x + c * 16, t);\n    for (int j = 0; j < 16; j++) xs[c * 16 + j] = t[j];\n  }\n  threadgroup_barrier(mem_flags::mem_threadgroup);\n  const int row0 = (threadgroup_position_in_grid.y * S + sg) * R;\n  const device uint8_t* ws = (const device uint8_t*)w + row0 * ROWB + lane * BPL;\n  const device T* sc = scales + row0 * GROUPS + lane / 4;\n  const device T* bi = biases + row0 * GROUPS + lane / 4;\n  float result[R] = {0};\n  #pragma clang loop unroll_count(1)\n  for (int k = 0; k < K; k += 512) {\n    const float sum = ss[(k + lane * 16) / 16];\n    const threadgroup float* x_thread = xs + k + lane * 16;\n    for (int r = 0; r < R; r++) {\n      const float s = sc[r * GROUPS];\n      const float b = bi[r * GROUPS];\n      result[r] += mlxq_qdot<BITS>(ws + r * ROWB, x_thread, s, b, sum);\n    }\n    ws += 32 * BPL;\n    sc += 8;\n    bi += 8;\n  }\n  for (int r = 0; r < R; r++) {\n    const float v = simd_sum(result[r]);\n    if (lane == 0) y[row0 + r] = static_cast<T>(v);\n  }\n"
    | .siluRmsHeads => chars!"\n  const uint lane = thread_index_in_simdgroup;\n  const uint head = threadgroup_position_in_grid.x;\n  const uint row = threadgroup_position_in_grid.y;\n  const bool normalize = head < uint(2 * HK);\n  const uint width = normalize ? uint(DK) : uint(DV);\n  const uint channel = normalize ? head * uint(DK)\n    : uint(2 * HK * DK) + (head - uint(2 * HK)) * uint(DV);\n  T values[4];\n  float sum = 0.0f;\n  for (uint i = 0; i < 4u; ++i) {\n    const uint col = lane * 4u + i;\n    const T value = col < width ? x[row * uint(C) + channel + col] : T(0);\n    const auto y = 1 / (1 + metal::exp(metal::abs(value)));\n    const T sigmoid = T(value < T(0) ? y : 1 - y);\n    values[i] = T(value * sigmoid);\n    const float activated = float(values[i]);\n    sum += activated * activated;\n  }\n  if (normalize) {\n    sum = metal::simd_sum(sum);\n    const float inv = metal::precise::rsqrt(sum / float(DK) + 1e-6f);\n    const uint index = (row * uint(HK) + head % uint(HK)) * uint(DK) + lane * 4u;\n    for (uint i = 0; i < 4u; ++i) {\n      if (lane * 4u + i >= uint(DK)) continue;\n      const T normalized = T(float(values[i]) * inv);\n      if (head < uint(HK)) q[index + i] = qscale[lane * 4u + i] * normalized;\n      else k[index + i] = kscale[lane * 4u + i] * normalized;\n    }\n  } else {\n    const uint index = (row * uint(HV) + head - uint(2 * HK)) * uint(DV) + lane * 4u;\n    for (uint i = 0; i < 4u; ++i) if (lane * 4u + i < uint(DV)) v[index + i] = values[i];\n  }\n"
    | .gatedDeltaStep => chars!"\n    const int T = Tin[0];\n    auto n = thread_position_in_grid.z;\n    auto b_idx = n / Hv;\n    auto hv_idx = n % Hv;\n    auto hk_idx = hv_idx / (Hv / Hk);\n    constexpr int n_per_t = Dk / 32;\n\n    // q, k: [B, T, Hk, Dk]\n    auto q_ = q + b_idx * T * Hk * Dk + hk_idx * Dk;\n    auto k_ = k + b_idx * T * Hk * Dk + hk_idx * Dk;\n\n    // v, y: [B, T, Hv, Dv]\n    auto v_ = v + b_idx * T * Hv * Dv + hv_idx * Dv;\n    y += b_idx * T * Hv * Dv + hv_idx * Dv;\n\n    auto dk_idx = thread_position_in_threadgroup.x;\n    auto dv_idx = thread_position_in_grid.y;\n\n    // state_in, state_out: [B, Hv, Dv, Dk]\n    auto i_state = state_in + (n * Dv + dv_idx) * Dk;\n    auto o_state = state_out + (n * Dv + dv_idx) * Dk;\n\n    float state[n_per_t];\n    for (int i = 0; i < n_per_t; ++i) {\n      auto s_idx = n_per_t * dk_idx + i;\n      state[i] = static_cast<float>(i_state[s_idx]);\n    }\n\n    // g: [B, T, Hv]\n    auto g_ = g + b_idx * T * Hv;\n    auto beta_ = beta + b_idx * T * Hv;\n\n    for (int t = 0; t < T; ++t) {\n      if (true) {\n        float kv_mem = 0.0f;\n        for (int i = 0; i < n_per_t; ++i) {\n          auto s_idx = n_per_t * dk_idx + i;\n          state[i] = state[i] * g_[hv_idx];\n          kv_mem += state[i] * k_[s_idx];\n        }\n        kv_mem = simd_sum(kv_mem);\n\n        auto delta = (v_[dv_idx] - kv_mem) * beta_[hv_idx];\n\n        float out = 0.0f;\n        for (int i = 0; i < n_per_t; ++i) {\n          auto s_idx = n_per_t * dk_idx + i;\n          state[i] = state[i] + k_[s_idx] * delta;\n          out += state[i] * q_[s_idx];\n        }\n        out = simd_sum(out);\n        if (thread_index_in_simdgroup == 0) {\n          y[dv_idx] = static_cast<InT>(out);\n        }\n      } else {\n        y[dv_idx] = static_cast<InT>(0);\n      }\n      // Increment data pointers to next time step\n      q_ += Hk * Dk;\n      k_ += Hk * Dk;\n      v_ += Hv * Dv;\n      y += Hv * Dv;\n      g_ += Hv;\n      beta_ += Hv;\n    }\n    for (int i = 0; i < n_per_t; ++i) {\n      auto s_idx = n_per_t * dk_idx + i;\n      o_state[s_idx] = static_cast<StT>(state[i]);\n    }\n"
    | .gatedRmsNorm => chars!"\n  const uint row = threadgroup_position_in_grid.x;\n  const uint lane = thread_index_in_simdgroup;\n  float acc = 0.0f;\n  const uint tid = thread_position_in_threadgroup.x;\n  threadgroup float sums[32];\n  threadgroup float inverse[1];\n  for (uint r = 0; r < uint(D); r += uint(THREADS) * 4u) {\n    for (uint i = 0; i < 4u; ++i) {\n      const uint col = r + tid * 4u + i;\n      const float value = col < uint(D) ? float(x[row * uint(D) + col]) : 0.0f;\n      acc += value * value;\n    }\n  }\n  acc = metal::simd_sum(acc);\n  if (THREADS > 32) {\n    const uint sg = simdgroup_index_in_threadgroup;\n    if (sg == 0) sums[lane] = 0.0f;\n    threadgroup_barrier(metal::mem_flags::mem_threadgroup);\n    if (lane == 0) sums[sg] = acc;\n    threadgroup_barrier(metal::mem_flags::mem_threadgroup);\n    if (sg == 0) {\n      acc = metal::simd_sum(sums[lane]);\n      if (lane == 0) inverse[0] = metal::precise::rsqrt(acc / float(D) + as_type<float>(uint(EPS)));\n    }\n    threadgroup_barrier(metal::mem_flags::mem_threadgroup);\n  }\n  const float inv = THREADS > 32 ? inverse[0]\n    : metal::precise::rsqrt(acc / float(D) + as_type<float>(uint(EPS)));\n  for (uint r = 0; r < uint(D); r += uint(THREADS) * 4u) {\n    for (uint i = 0; i < 4u; ++i) {\n      const uint col = r + tid * 4u + i, index = row * uint(D) + col;\n      if (col >= uint(D)) continue;\n      const T normalized = weight[col] * T(float(x[index]) * inv);\n      const float g = float(gate[index]);\n      const float y = 1.0f / (1.0f + metal::exp(metal::abs(g)));\n      const float sigmoid = g < 0.0f ? y : 1.0f - y;\n      out[index] = T((g * sigmoid) * float(normalized));\n    }\n  }\n"
    | .residualRmsNorm => chars!"\n  const uint row = threadgroup_position_in_grid.x;\n  const uint tid = thread_position_in_threadgroup.x;\n  const uint lane = thread_index_in_simdgroup;\n  const uint sg = simdgroup_index_in_threadgroup;\n  threadgroup float sums[32];\n  threadgroup float inv[1];\n  float acc = 0.0f;\n  for (uint r = 0; r < uint(D); r += uint(THREADS) * 4u) {\n    for (uint i = 0; i < 4u; ++i) {\n      const uint col = r + tid * 4u + i;\n      if (col < uint(D)) {\n        const uint index = row * uint(D) + col;\n        const T value = T(float(x[index]) + float(update[index]));\n        residual[index] = value;\n        const float v = float(value);\n        acc += v * v;\n      }\n    }\n  }\n  acc = metal::simd_sum(acc);\n  if (sg == 0) sums[lane] = 0.0f;\n  threadgroup_barrier(metal::mem_flags::mem_threadgroup);\n  if (lane == 0) sums[sg] = acc;\n  threadgroup_barrier(metal::mem_flags::mem_threadgroup);\n  if (sg == 0) {\n    acc = metal::simd_sum(sums[lane]);\n    if (lane == 0) inv[0] = metal::precise::rsqrt(acc / float(D) + as_type<float>(uint(EPS)));\n  }\n  threadgroup_barrier(metal::mem_flags::mem_threadgroup | metal::mem_flags::mem_device);\n  for (uint r = 0; r < uint(D); r += uint(THREADS) * 4u) {\n    for (uint i = 0; i < 4u; ++i) {\n      const uint col = r + tid * 4u + i;\n      if (col < uint(D)) {\n        const uint index = row * uint(D) + col;\n        normalized[index] = weight[col] * T(float(residual[index]) * inv[0]);\n      }\n    }\n  }\n"
    | .gateUp => chars!"\n  threadgroup float codebook[1 << L];\n  threadgroup uint4 xs[C / 8];\n  constexpr uint N_RUNS = (uint)C / 32u;\n  for (uint i = thread_position_in_threadgroup.x; i < (1u << (uint)L); i += (uint)THREADS)\n    codebook[i] = trellis_unrefined_bits_y(trellis_y(i));\n  // Chunk q (positions 8q..8q+7) of run r at qÂ·N_RUNS + r.\n  for (uint c = thread_position_in_threadgroup.x; c < (uint)C / 8u; c += (uint)THREADS)\n    xs[c] = ((const device uint4*)x)[(c % N_RUNS) * 4u + c / N_RUNS];\n  threadgroup_barrier(metal::mem_flags::mem_threadgroup);\n  const threadgroup uchar* table = (const threadgroup uchar*)codebook;\n  const uint lane = thread_index_in_simdgroup;\n  const uint gWpb = (uint)(BT * KG / 32);\n  const uint uWpb = (uint)(BT * KU / 32);\n  const uint runsPerBlock = (uint)BT / 32u;\n  const uint rowStep = threadgroups_per_grid.y * (uint)ROWS_TG;\n  for (uint row = thread_position_in_grid.y * (uint)ROWS_TG + simdgroup_index_in_threadgroup; row < (uint)R; row += rowStep) {\n    const uint gRow = row * (uint)((C / BT) * gWpb);\n    const uint uRow = row * (uint)((C / BT) * uWpb);\n    const float gScale = float(gscales[row]);\n    const float uScale = float(uscales[row]);\n    float gAcc = 0.0f, gAcc2 = 0.0f, uAcc = 0.0f, uAcc2 = 0.0f;\n    for (uint run = lane; run < N_RUNS; run += 32u) {\n      const uint blk = run / runsPerBlock;\n      const uint t0 = (run - blk * runsPerBlock) * 32u;\n      const uint gw = gRow + blk * gWpb, uw = uRow + blk * uWpb;\n      const uint gW0 = ((uint)BT - 32u - t0) * (uint)KG / 32u;\n      const uint uW0 = ((uint)BT - 32u - t0) * (uint)KU / 32u;\n      uint g[KG + 1], gv[KG + 1];\n      uint u[KU + 1], uv[KU + 1];\n      // Words W0 .. W0 + K - 1 stay in the block; the next word wraps to the block's first for its last run.\n      #pragma clang loop unroll(full)\n      for (uint i = 0; i < (uint)KG; ++i) g[i] = gcodes[gw + gW0 + i];\n      g[KG] = gcodes[gw + (t0 == 0u ? 0u : gW0 + (uint)KG)];\n      #pragma clang loop unroll(full)\n      for (uint i = 0; i < (uint)KU; ++i) u[i] = ucodes[uw + uW0 + i];\n      u[KU] = ucodes[uw + (t0 == 0u ? 0u : uW0 + (uint)KU)];\n      // Virtual words: bits [32i - 16, 32i + 16) of the run's words (only the ignored bits below word 0 are absent).\n      gv[0] = g[0] << 16;\n      uv[0] = u[0] << 16;\n      #pragma clang loop unroll(full)\n      for (uint i = 1; i <= (uint)KG; ++i) gv[i] = (g[i - 1] >> 16) | (g[i] << 16);\n      #pragma clang loop unroll(full)\n      for (uint i = 1; i <= (uint)KU; ++i) uv[i] = (u[i - 1] >> 16) | (u[i] << 16);\n      #pragma clang loop unroll(full)\n      for (uint q = 0; q < 4u; ++q) {\n        const uint4 chunk = xs[q * N_RUNS + run];\n        #pragma clang loop unroll(full)\n        for (uint p = 0; p < 8u; ++p) {\n          const uint j = q * 8u + p;\n          // The bf16 in either half of a word, as the float of its bits.\n          const float xv = as_type<float>((p & 1u) ? chunk[p >> 1] & 0xFFFF0000u : chunk[p >> 1] << 16);\n          const float gWeight = trellis_codebook_window(table, g, gv, (31u - j) * (uint)KG, (uint)L) * gScale;\n          const float uWeight = trellis_codebook_window(table, u, uv, (31u - j) * (uint)KU, (uint)L) * uScale;\n          if (j & 1u) { gAcc2 = metal::fma(gWeight, xv, gAcc2); uAcc2 = metal::fma(uWeight, xv, uAcc2); }\n          else { gAcc = metal::fma(gWeight, xv, gAcc); uAcc = metal::fma(uWeight, xv, uAcc); }\n        }\n      }\n    }\n    const float gate = metal::simd_sum(gAcc + gAcc2);\n    const float up = metal::simd_sum(uAcc + uAcc2);\n    if (lane == 0u) {\n      const T gateT = T(gate);\n      const T upT = T(up);\n      if ((TAIL) == 1) {\n        const T sigY = 1 / (1 + metal::exp(metal::abs(gateT)));\n        const T sigmoidT = (gateT < 0) ? sigY : 1 - sigY;\n        const T siluT = gateT * sigmoidT;\n        mid[row] = siluT * upT;\n      } else {\n        const T sigmoidT = T(1.0f / (1.0f + metal::precise::exp(-float(gateT))));\n        const T siluT = T(float(gateT) * float(sigmoidT));\n        mid[row] = T(float(siluT) * float(upT));\n      }\n    }\n  }\n"
    | .downPartial => chars!"\n  threadgroup float codebook[4096];  // 2^L codes, then the eight SIMD groups' partials\n  for (uint i = thread_position_in_threadgroup.x; i < (1u << (uint)L); i += (uint)THREADS)\n    codebook[i] = trellis_unrefined_bits_y(trellis_y(i));\n  threadgroup_barrier(metal::mem_flags::mem_threadgroup);\n  constexpr uint BITS = (uint)(P * K);               // a lane's bits\n  constexpr uint SHIFT = BITS % 32u;                 // 0, or 16: odd lanes start at bit 16 of a word\n  constexpr bool ALIGNED = SHIFT == 0u;\n  constexpr uint NA = (BITS + (uint)L - (uint)K + 31u) / 32u;  // words its windows span from its first bit\n  constexpr uint NL = ALIGNED ? NA : NA + 1u;        // words it loads\n  constexpr uint LB = 256u / (uint)P;                // lanes per block\n  constexpr uint WPB = 8u * (uint)K;                 // words per block\n  constexpr uint NB = (uint)(C / 256);               // blocks\n  constexpr uint SGS = (NB + 32u / LB - 1u) / (32u / LB); // SIMD groups per split\n  constexpr ulong ROWW = INTERLEAVE ? 2ul * WPB : (ulong)NB * WPB;\n  constexpr uint ROWS_PER = ((uint)R + (uint)SPLITS - 1u) / (uint)SPLITS;\n  constexpr uint SG_COLS = 32u * (uint)P;            // a SIMD group's columns\n  // Threadgroup t: row group y = t % 32 and SIMD groups (k, c) = (s % 4, s / 4) take split y + 32k of column group\n  // 2Â·(t / 32) + c, so the threadgroup holds the four splits MLX's column sum adds first for 2Â·SG_COLS columns.\n  const uint lane = thread_index_in_simdgroup;\n  const uint sg = simdgroup_index_in_threadgroup;\n  const uint ty = threadgroup_position_in_grid.y;\n  const uint y = ty % 32u;\n  const uint split = y + 32u * (sg % 4u);\n  const uint colGroup = 2u * (ty / 32u) + sg / 4u;\n  const uint li = lane % LB;\n  const uint blk = colGroup * (32u / LB) + lane / LB;\n  const bool active = colGroup < SGS && blk < NB;\n  const device uint32_t* blockWords = codes + (!active ? 0ul : INTERLEAVE\n    ? (ulong)(blk / 2u) * (ulong)R * 2ul * WPB + (blk % 2u) * WPB : (ulong)blk * WPB);\n  const uint first = (li * BITS) >> 5;\n  const bool shifted = !ALIGNED && (li & 1u);\n  uint idx[NL];\n  #pragma clang loop unroll(full)\n  for (uint i = 0; i < NL; ++i) idx[i] = (first + i) % WPB;\n  const uint r0 = split * ROWS_PER;\n  const uint rows = !active ? 0u : (uint)R % (uint)SPLITS == 0u ? ROWS_PER : r0 >= (uint)R ? 0u : metal::min(ROWS_PER, (uint)R - r0);\n  const threadgroup uchar* table = (const threadgroup uchar*)codebook;\n  float acc[P];\n  #pragma clang loop unroll(full)\n  for (uint i = 0; i < (uint)P; ++i) acc[i] = 0.0f;\n  uint r = 0;\n  for (; r + (uint)U <= rows; r += (uint)U) {\n    uint ld[U][NL];\n    float xr[U], sr[U];\n    #pragma clang loop unroll(full)\n    for (uint u = 0; u < (uint)U; ++u) {\n      const device uint32_t* rowWords = blockWords + (ulong)(r0 + r + u) * ROWW;\n      #pragma clang loop unroll(full)\n      for (uint i = 0; i < NL; ++i) ld[u][i] = rowWords[idx[i]];\n      xr[u] = float(x[r0 + r + u]);\n      sr[u] = float(scales[r0 + r + u]);\n    }\n    #pragma clang loop unroll(full)\n    for (uint u = 0; u < (uint)U; ++u) {\n      uint w[NA], v[NA];\n      #pragma clang loop unroll(full)\n      for (uint i = 0; i < NA; ++i) w[i] = shifted ? (ld[u][i] >> SHIFT) | (ld[u][i + 1] << (32u - SHIFT)) : ld[u][i];\n      v[0] = w[0] << 16;\n      #pragma clang loop unroll(full)\n      for (uint i = 1; i < NA; ++i) v[i] = (w[i - 1] >> 16) | (w[i] << 16);\n      #pragma clang loop unroll(full)\n      for (uint i = 0; i < (uint)P; ++i) {\n        const float code = trellis_codebook_window(table, w, v, i * (uint)K, (uint)L);\n        acc[i] = metal::fma(code * sr[u], xr[u], acc[i]);\n      }\n    }\n  }\n  for (; r < rows; ++r) {\n    const device uint32_t* rowWords = blockWords + (ulong)(r0 + r) * ROWW;\n    uint ld[NL];\n    #pragma clang loop unroll(full)\n    for (uint i = 0; i < NL; ++i) ld[i] = rowWords[idx[i]];\n    const float xr = float(x[r0 + r]);\n    const float sr = float(scales[r0 + r]);\n    uint w[NA], v[NA];\n    #pragma clang loop unroll(full)\n    for (uint i = 0; i < NA; ++i) w[i] = shifted ? (ld[i] >> SHIFT) | (ld[i + 1] << (32u - SHIFT)) : ld[i];\n    v[0] = w[0] << 16;\n    #pragma clang loop unroll(full)\n    for (uint i = 1; i < NA; ++i) v[i] = (w[i - 1] >> 16) | (w[i] << 16);\n    #pragma clang loop unroll(full)\n    for (uint i = 0; i < (uint)P; ++i) {\n      const float code = trellis_codebook_window(table, w, v, i * (uint)K, (uint)L);\n      acc[i] = metal::fma(code * sr, xr, acc[i]);\n    }\n  }\n  // The four splits' partials meet in the codebook's memory; each column's first sum stage, ((0 + p[y]) + p[y + 32])\n  // + ..., in MLX's order, goes out as row y of the 32 the fold sums.\n  threadgroup_barrier(metal::mem_flags::mem_threadgroup);\n  threadgroup float* sums = codebook;\n  const uint local = (lane / LB) * 256u + 255u - li * (uint)P;\n  #pragma clang loop unroll(full)\n  for (uint i = 0; i < (uint)P; ++i) sums[sg * SG_COLS + local - i] = acc[i];\n  threadgroup_barrier(metal::mem_flags::mem_threadgroup);\n  for (uint c = thread_position_in_threadgroup.x; c < 2u * SG_COLS; c += (uint)THREADS) {\n    const uint group2 = c / SG_COLS, col = (2u * (ty / 32u) + group2) * SG_COLS + c % SG_COLS;\n    if (col >= (uint)C) continue;\n    float t = 0.0f;\n    #pragma clang loop unroll(full)\n    for (uint k = 0; k < 4u; ++k) t = sums[(group2 * 4u + k) * SG_COLS + c % SG_COLS] + t;\n    partial[(ulong)y * (ulong)C + col] = t;\n  }\n"
