    "./panel": "./src/panel/index.ts"
  },
  "files": [
    "src",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "@mlx-bun/app-core": "workspace:*",
    "@mlx-bun/inference": "workspace:*",
    "@mlx-bun/mlx": "workspace:*",
    "@mlx-bun/quantize": "workspace:*",
    "@mlx-bun/training": "workspace:*"
  },
  "devDependencies": {
    "@mlx-bun/app-host": "workspace:*",
    "@mlx-bun/app-services": "workspace:*",
    "happy-dom": "20.10.6"
