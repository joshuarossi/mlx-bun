    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "@mlx-bun/app-core": "workspace:*"
  },
  "devDependencies": {
    "@mlx-bun/app-host": "workspace:*",
    "@mlx-bun/app-services": "workspace:*",
    "happy-dom": "20.10.6"
  },
