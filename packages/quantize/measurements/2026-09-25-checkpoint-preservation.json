  "method": {
    "entryPoint": "quantizeModelDir(sourceDirectory, outputDirectory, options)",
    "launch": "Separate sequential Bun processes with --no-env-file; ambient MLX_/HF_/TOKENIZERS_/ORACLE_ variables removed before the recorded overrides.",
    "comparison": "Require identical options, input manifest and tensor hashes, calibration IDs, native hashes, environment and result metadata. Compare every named output tensor by dtype, shape and SHA-256 of raw safetensors payload bytes, then every output file by SHA-256. No float conversion or tolerance.",
    "mixedBaseline": "Default ProbeSource builds a temporary uniform 8-bit baseline from bf16, runs exact per-layer KL sensitivity, then removes the baseline. Candidate 8-bit equals the baseline and short-circuits; candidate 4-bit is probed for all 294 attention/MLP projections.",
    "calibration": {
      "samples": 1,
      "sequenceLength": 128,
      "batchSize": 1,
      "seed": 42,
      "jsonlSha256": "cf7c411be077f24f329d620ca718be678e2cc378a8da0cfb8baf543b34449162",
      "generation": {
        "text": "A library exposes reusable operations through explicit interfaces. Arrays carry numerical values and shapes. Model graphs compose layers, and layers select kernels. The same input and configuration must preserve numerical behavior during migration.",
        "repetitions": 24,
        "separator": " ",
        "format": "One JSONL object with a text field, encoded with Python json.dumps defaults and a final newline."
      },
