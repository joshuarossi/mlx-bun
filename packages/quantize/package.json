    "./sensitivity": "./src/sensitivity.ts",
    "./calibration": "./src/calibration.ts",
    "./rotate": "./src/rotate.ts",
    "./weight-transform": "./src/weight-transform.ts",
    "./trellis": "./src/trellis.ts",
