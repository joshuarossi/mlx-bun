{
  "name": "mlx-bun-website",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "generate": "bun scripts/generate-reference.ts",
    "dev": "bun run generate && bun --bun astro dev",
    "build": "bun run generate && bun --bun astro build && bun scripts/check-build.ts",
    "typecheck": "bun --bun astro sync && tsc --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "@astrojs/starlight": "0.40.0",
    "astro": "6.4.8",
    "sharp": "0.34.5"
  },
  "devDependencies": {
    "typescript": "6.0.3",
    "@types/bun": "1.3.14"
  }
}
