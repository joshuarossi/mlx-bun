---
// The landing page's hero: Starlight's hero frontmatter (title, tagline,
// actions) in a two-column layout with the install command and a terminal that
// types the quickstart. Docs pages declare no hero and never render this.
import { Icon, LinkButton } from '@astrojs/starlight/components';

const { data } = Astro.locals.starlightRoute.entry;
const { title = data.title, tagline, actions = [] } = data.hero || {};

const install = 'curl -fsSL https://mlx-bun.dev/install.sh | sh';
const model = 'mlx-community/gemma-4-e4b-it-OptiQ-4bit';
/** The quickstart's commands and the lines `mlx-bun serve` prints, in order.
 * The install command stays in the copy column: a shell that just ran the
 * installer may not have `~/.local/bin` on PATH yet. */
const script: { kind: 'cmd' | 'out'; text: string; url?: boolean }[] = [
  { kind: 'cmd', text: `mlx-bun get ${model}` },
  { kind: 'cmd', text: 'mlx-bun serve e4b' },
  { kind: 'out', text: `Serving ${model}` },
  { kind: 'out', text: 'App  http://127.0.0.1:8080/#/chat', url: true },
  { kind: 'out', text: 'API  http://127.0.0.1:8080/v1', url: true },
];
// A command types at a fixed pace and pauses before the next line; output
// appears a beat after the command that produced it.
let at = 0.5;
const lines = script.map((line) => {
  const chars = line.kind === 'cmd' ? line.text.length + 2 : line.text.length;
  const start = at;
  at += line.kind === 'cmd' ? chars * 0.026 + 0.55 : 0.14;
  return { ...line, chars, start };
});
---

<div class="lp-hero">
  <div class="lp-hero-copy">
    <p class="lp-hero-badge"><span class="lp-pulse" aria-hidden="true"></span>Apple Silicon · macOS 14+ · MIT</p>
    <h1 id="_top" data-page-title set:html={title} />
    {tagline && <p class="lp-hero-tagline" set:html={tagline} />}
    {
      actions.length > 0 && (
        <div class="lp-hero-actions">
          {actions.map(({ attrs: { class: className, ...attrs } = {}, icon, link: href, text, variant }) => (
            <LinkButton {href} {variant} icon={icon?.name} class:list={[className]} {...attrs}>
              {text}
              {icon?.html && <Fragment set:html={icon.html} />}
            </LinkButton>
          ))}
        </div>
      )
    }
    <div class="lp-install" data-copy={install}>
      <span class="lp-install-prompt" aria-hidden="true">$</span>
      <code>{install}</code>
      <button type="button" class="lp-copy" aria-label="Copy the install command">
        <Icon name="document" class="lp-copy-idle" size="1.1rem" />
        <Icon name="approve-check" class="lp-copy-done" size="1.1rem" />
      </button>
    </div>
  </div>
  <div class="lp-hero-visual">
    <div class="lp-terminal" aria-hidden="true">
      <div class="lp-terminal-bar"><span></span><span></span><span></span><em>mlx-bun · zsh</em></div>
      <pre class="lp-terminal-body"><code>{lines.map((line) => (
        <span class={`lp-line lp-${line.kind}`} style={`--n:${line.chars};--t:${line.start.toFixed(2)}s`}>{line.kind === 'cmd' && <span class="lp-prompt">$ </span>}{line.url ? <>{line.text.slice(0, 5)}<span class="lp-url">{line.text.slice(5)}</span></> : line.text}</span>
      ))}<span class="lp-line lp-out" style={`--n:2;--t:${at.toFixed(2)}s`}><span class="lp-prompt">$ </span><span class="lp-cursor"></span></span></code></pre>
    </div>
  </div>
</div>

<script>
  for (const box of document.querySelectorAll<HTMLElement>('.lp-install[data-copy]')) {
    const button = box.querySelector<HTMLButtonElement>('button.lp-copy');
    if (!button) continue;
    button.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(box.dataset.copy ?? '');
      } catch {
        return;
      }
      button.classList.add('is-copied');
      setTimeout(() => button.classList.remove('is-copied'), 1600);
    });
  }
</script>
