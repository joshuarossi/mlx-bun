{
  "name": "mlx-bun-workspace",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "bun@1.4.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "typecheck": "bun run --filter '*' typecheck && tsc --project scripts/tsconfig.json",
    "test": "bun run --filter '*' test",
    "verify:packages": "bun scripts/verify-packages.ts",
    "build:binary": "bun scripts/build-binary.ts",
    "verify:binary": "bun scripts/verify-binary.ts"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "typescript": "6.0.3"
  }
}
